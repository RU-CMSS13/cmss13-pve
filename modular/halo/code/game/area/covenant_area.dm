// SS220 HALO modular override: Covenant admin areas use modular DMI
// instead of root icons/turf/areas.dmi to avoid injecting HALO states into generic assets.

/area/adminlevel/covenant
	icon = 'modular/halo/icons/turf/areas_covenant.dmi'

/area/adminlevel/covenant/no_baselight
	icon = 'modular/halo/icons/turf/areas_covenant.dmi'
