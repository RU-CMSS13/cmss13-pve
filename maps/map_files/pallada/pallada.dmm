"eW" = (
/obj/structure/prop{
	icon = 'icons/obj/items/paper.dmi';
	icon_state = "photo";
	desc = "Старый снимок, распечатанный на жестком синтетическом листе. На изображении запечатлен боец Первых экспедиционных сил Союза. Он облачен в архаичный, массивный скафандр, покрытый въевшейся шлаковой пылью и глубокими царапинами - следами работы в агрессивных средах. Забрало шлема поднято, открывая мрачное, изможденное лицо человека, привыкшего к тяжелому труду в глубоком космосе. В руках он сжимает потертый автомат, а на заднем плане виднеются угловатые очертания десантного модуля Союза.";
	name = "Взгляд сквозь эпохи";
	pixel_x = -1;
	pixel_y = -2;
	layer = 3.1
	},
/obj/structure/prop{
	icon = 'icons/obj/items/paper.dmi';
	icon_state = "photo";
	desc = "Архивный физический снимок на плотной полимерной подложке. На нем запечатлен отряд ранних колониальных сил Союза в громоздких экспедиционных скафандрах модели ССС2. На массивных нагрудных пластинах и шлемах едва различимы стертые номера подразделений. Люди стоят плотным строем на фоне скалистого, безжизненного ландшафта немаркированной планеты. Качество печати выдает утилитарные технологии прошлого. В нижнем углу снимка черным маркером небрежно выведено: 'Говорун'.";
	name = "Отряд 'Говорун'";
	pixel_x = -14;
	pixel_y = -7;
	layer = 3.1
	},
/turf/closed/wall/upp_wall/grey/hull,
/area/golden_arrow/briefing)
